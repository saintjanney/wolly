  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "25.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "fast-xml-parser": "5.12.1",
    "puppeteer": "25.17.0",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0"
  }
}
