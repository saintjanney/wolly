{
  "name": "@wolly/converter",
  "version": "1.0.0",
  "private": true,
  "description": "Manuscript-to-EPUB/PDF conversion service. Wolly's publishing press.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
