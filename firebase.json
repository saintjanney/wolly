{
  "firestore": {
    "rules": "packages/firebase-config/firestore.rules",
    "indexes": "packages/firebase-config/firestore.indexes.json"
  },
  "storage": {
    "rules": "packages/firebase-config/storage.rules"
  },
  "hosting": [
    {
      "target": "creator-hub",
      "public": "apps/creator-hub/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "backoffice",
      "public": "apps/backoffice/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "blog",
      "public": "apps/blog/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "wolly-blog",
            "region": "europe-west2"
          }
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "services/api",
      "codebase": "api",
      "predeploy": [
        "npm --workspace @wolly/api run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src",
        "tsconfig.json"
      ]
    },
    {
      "source": "services/payments",
      "codebase": "payments",
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        ".runtimeconfig.json"
      ],
      "predeploy": [
        "sh services/payments/predeploy-guard.sh"
      ]
    },
    {
      "source": "services/converter",
      "codebase": "converter",
      "predeploy": [
        "npm --workspace @wolly/converter run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src",
        "test",
        "tsconfig.json",
        "eslint.config.mjs"
      ]
    }
  ]
}
