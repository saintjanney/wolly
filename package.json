{
  "name": "wolly-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/creator-hub",
    "apps/backoffice",
    "apps/blog",
    "apps/storefront",
    "packages/api-client",
    "services/converter"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contracts:generate": "python3 scripts/generate-contract-types.py",
    "contracts:check": "python3 scripts/generate-contract-types.py --check",
    "check:boundaries": "python3 scripts/check-boundaries.py"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "minimatch": "^11.0.1"
  }
}
