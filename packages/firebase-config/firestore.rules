rules_version = '2';

// Wolly platform security rules.
//
// This file is the SOURCE OF TRUTH and is what CI deploys. It was previously
// far behind the ruleset actually running in production (it described only the
// dead `books` collection), so `firebase deploy` would have stripped access for
// the reader and creator-hub. Do not let it drift again: every change here ships
// with a rules test, and no rule is added for a collection nothing reads.
//
// Collections in use, verified against both the code and the live database:
//   reference (read-only):  countries, genres, supported_currencies,
//                           payment_methods, payment_schedules
//   profiles:               users
//   books:                  epubs
//   commerce:               purchases, payouts
//   reader state:           reading_progress, bookmarks, follows
//   moderation:             reviews
//   blog:                   publications (+tiers, email_sends),
//                           publication_slugs, posts (+content, revisions,
//                           likes, comments, stats), subscriptions,
//                           email_suppressions
//
// Deliberately REMOVED (no code reads them, no documents exist): books,
// analytics, publishing_queue, content_files, book_drafts, payments,
// notifications, categories.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    /**
     * Nothing may be published without an owner. This is what allowed 48
     * unowned books into the live catalog; it must never be possible again,
     * for books or for posts.
     */
    function publishedImpliesOwned() {
      return request.resource.data.isPublished != true
        || (request.resource.data.ownerUserId is string
            && request.resource.data.ownerUserId.size() > 0);
    }

    /**
     * Book fields only the server may write.
     *
     * `rightsStatus` is the one that matters most: it is what a takedown sets,
     * and if the book's own author could write it, they could clear their own
     * revocation and the takedown would be decoration. `conversion` holds the
     * forensic pressing record used to trace a leaked file back to a copy, so a
     * client that could forge it could disown its own book. The converter and
     * the backoffice write these through the Admin SDK, which bypasses rules.
     */
    function serverOwnedBookFields() {
      return [
        'conversion',
        'conversionError',
        'epubUrl',
        'pdfUrl',
        'rightsStatus',
        'rightsNote',
        'rightsUpdatedAt'
      ];
    }

    function writesServerOwnedBookFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(serverOwnedBookFields());
    }

    /**
     * An author may ASK for a pressing, and nothing more. `requested` is the
     * only value a client may write; the converter owns 'processing', 'ready'
     * and 'failed'. Without this an author could mark a book 'ready' with a
     * `url` of their choosing and never go through the press at all.
     */
    function conversionStatusIsRequestOnly() {
      return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['conversionStatus'])
        || request.resource.data.conversionStatus == 'requested';
    }

    // ── Reference data (read-only to clients) ───────────────────────────────
    match /countries/{countryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /supported_currencies/{currencyId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /payment_methods/{methodId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /payment_schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /genres/{genreId} {
      allow read: if isAuthenticated();
      // Written by the backoffice genre manager, and by seed scripts via the
      // Admin SDK (which bypasses rules entirely).
      allow write: if isAdmin();
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated()
        && (isOwner(userId) || resource.data.publicProfile == true);
      allow read: if isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    // ── Books ──────────────────────────────────────────────────────────────
    match /epubs/{bookId} {
      allow read: if isAuthenticated() && resource.data.isPublished == true;
      allow read: if isAuthenticated() && isOwner(resource.data.ownerUserId);
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.ownerUserId == request.auth.uid
        && publishedImpliesOwned()
        && !request.resource.data.keys().hasAny(serverOwnedBookFields())
        && (!('conversionStatus' in request.resource.data)
            || request.resource.data.conversionStatus == 'requested');
      allow update: if isAuthenticated()
        && isOwner(resource.data.ownerUserId)
        && publishedImpliesOwned()
        && !writesServerOwnedBookFields()
        && conversionStatusIsRequestOnly();
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerUserId);
    }

    // ── Commerce ───────────────────────────────────────────────────────────
    // Purchases are SERVER-WRITTEN ONLY.
    //
    // A client used to be able to create one, which meant a reader could grant
    // themselves any paid book by writing a single document; the reader app did
    // exactly that as soon as the checkout URL opened, without waiting for a
    // payment. Creation now belongs to initializePaystackCheckout (as `pending`)
    // and promotion to `completed` belongs to verifyPaystackPayment, which
    // confirms the transaction with Paystack and checks the amount. Both use the
    // Admin SDK, which bypasses these rules. See services/payments.
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        (exists(/databases/$(database)/documents/epubs/$(resource.data.bookId)) &&
         get(/databases/$(database)/documents/epubs/$(resource.data.bookId)).data.ownerUserId == request.auth.uid)
      );
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Reader state ───────────────────────────────────────────────────────
    match /reading_progress/{progressId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && isOwner(resource.data.followerId);
      allow update: if false;
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuthenticated() && resource.data.status == 'approved';
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAuthenticated()
        && isOwner(resource.data.userId)
        // A reviewer may edit their own text but never their moderation state.
        && request.resource.data.status == resource.data.status;
      allow update, delete: if isAdmin();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  BLOG (see BLOG_SPEC.md)
    // ═══════════════════════════════════════════════════════════════════════

    function pubOwner(pubId) {
      return get(/databases/$(database)/documents/publications/$(pubId)).data.ownerUserId;
    }

    function ownsPublication(pubId) {
      return isAuthenticated() && pubOwner(pubId) == request.auth.uid;
    }

    function subPath(pubId) {
      return /databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + pubId);
    }

    function hasAnySub(pubId) {
      return isAuthenticated() && exists(subPath(pubId));
    }

    function hasActivePaidSub(pubId) {
      return isAuthenticated()
        && exists(subPath(pubId))
        && get(subPath(pubId)).data.isPaid == true
        && get(subPath(pubId)).data.currentPeriodEnd > request.time;
    }

    // ── Publications ───────────────────────────────────────────────────────
    match /publications/{pubId} {
      allow read: if isAuthenticated() && resource.data.status == 'active';
      allow read: if isAuthenticated() && isOwner(resource.data.ownerUserId);
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.subscriberCount == 0
        && request.resource.data.paidSubscriberCount == 0
        && request.resource.data.postCount == 0;

      allow update: if isAuthenticated()
        && isOwner(resource.data.ownerUserId)
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.slug == resource.data.slug
        // Counters are maintained server-side.
        && request.resource.data.subscriberCount == resource.data.subscriberCount
        && request.resource.data.paidSubscriberCount == resource.data.paidSubscriberCount
        && request.resource.data.postCount == resource.data.postCount;
      allow update: if isAdmin();
      allow delete: if false;  // archive via status instead

      match /tiers/{tierId} {
        allow read: if isAuthenticated();
        allow write: if ownsPublication(pubId);
      }

      match /email_sends/{sendId} {
        allow read: if ownsPublication(pubId) || isAdmin();
        allow write: if false;  // Admin SDK only
      }
    }

    // Slug reservations. Created in the same transaction as a publication to
    // give Firestore the unique constraint it does not have natively.
    match /publication_slugs/{slug} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerUserId);
    }

    // ── Posts ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      function post() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }

      // Metadata is the teaser: readable for any live post. The body is gated
      // separately under /content below.
      //
      // This tests ONE denormalised boolean rather than `status == 'published'
      // && moderationStatus != 'removed'`. Firestore evaluates rules for a
      // `list` query against the query itself, so a clause the query cannot
      // provably satisfy fails the entire query, and no query filter can prove
      // an inequality like `moderationStatus != 'removed'`. The old form made
      // every reader feed query permission-denied while looking correct.
      //
      // `isPubliclyReadable` is derived server-side by derivePubliclyReadable()
      // in @wolly/schema and covers published and unlisted, minus removed.
      allow read: if isAuthenticated() && resource.data.isPubliclyReadable == true;
      allow read: if isAuthenticated() && isOwner(resource.data.ownerUserId);
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.ownerUserId == request.auth.uid
        && ownsPublication(request.resource.data.publicationId)
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.moderationStatus == 'ok'
        // Only the publish callable may make a post publicly readable.
        && request.resource.data.isPubliclyReadable == false;

      allow update: if isAuthenticated()
        && isOwner(resource.data.ownerUserId)
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.publicationId == resource.data.publicationId
        // Counters and moderation state are maintained server-side.
        && request.resource.data.viewCount == resource.data.viewCount
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        // Server-maintained, like the counters above.
        && request.resource.data.isPubliclyReadable == resource.data.isPubliclyReadable;
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerUserId);

      // ── The paywall ──────────────────────────────────────────────────────
      // This is where a paid post is actually protected. Because the paid body
      // is its own document, the database enforces the paywall directly and the
      // Flutter reader needs no server round-trip.
      match /content/{segment} {
        allow read: if isAuthenticated() && isOwner(post().ownerUserId);
        allow read: if isAdmin();

        allow read: if segment == 'free'
          && isAuthenticated()
          && post().status == 'published'
          && post().moderationStatus != 'removed'
          && (
            post().visibility == 'public'
            || hasAnySub(post().publicationId)
            || hasActivePaidSub(post().publicationId)
          );

        allow read: if segment == 'paid'
          && post().status == 'published'
          && post().moderationStatus != 'removed'
          && hasActivePaidSub(post().publicationId);

        // The author may save DRAFT JSON directly, but may never write `html`
        // or `plainText`.
        //
        // This is a security boundary, not a tidiness rule. The blog website
        // injects `html` with dangerouslySetInnerHTML on an origin shared by
        // every publication, so a creator running a modified client could
        // otherwise store script that runs against other publications' readers
        // and, once Phase 2 lands session cookies, against paid subscribers'
        // sessions. Those two fields are written only by the `publishPost`
        // callable in services/api, whose renderer emits a closed set of tags.
        allow write: if isAuthenticated()
          && isOwner(post().ownerUserId)
          && !('html' in request.resource.data)
          && !('plainText' in request.resource.data);
      }

      match /revisions/{revisionId} {
        allow read, write: if isAuthenticated() && isOwner(post().ownerUserId);
      }

      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated() && resource.data.status == 'visible';
        allow read: if isAuthenticated() && isOwner(resource.data.userId);
        allow read: if isAdmin();

        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'visible'
          && request.resource.data.likeCount == 0
          && request.resource.data.reportCount == 0;

        allow update: if isAuthenticated()
          && isOwner(resource.data.userId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.reportCount == resource.data.reportCount;
        allow update, delete: if isAdmin();
        allow delete: if isAuthenticated() && isOwner(resource.data.userId);
      }

      match /stats/{day} {
        allow read: if isAuthenticated() && isOwner(post().ownerUserId);
        allow read: if isAdmin();
        allow write: if false;  // Admin SDK only
      }
    }

    // ── Subscriptions ──────────────────────────────────────────────────────
    // Everything that grants paid access is Admin-SDK-only, written by the
    // Paystack webhook. A client may create a free subscription for itself and
    // change its own email preferences, and nothing else.
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow read: if isAuthenticated() && isOwner(resource.data.ownerUserId);
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && subId == request.auth.uid + '_' + request.resource.data.publicationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isPaid == false
        && request.resource.data.status == 'free'
        && !('currentPeriodEnd' in request.resource.data)
        && !('tierId' in request.resource.data)
        && !('paystackSubscriptionCode' in request.resource.data);

      allow update: if isAuthenticated()
        && isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['emailOptIn', 'unsubscribedAt', 'updatedAt']);

      allow delete: if false;  // unsubscribing sets status, never deletes
    }

    match /email_suppressions/{emailHash} {
      allow read, write: if false;  // Admin SDK only
    }
  }
}
