rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Books collection - users can upload/manage their own book files
    match /books/{userId}/{bookId}/{fileName} {
      // Allow read if user owns the file or book is published
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        // Future: allow public read for published books
        false
      );
      
      // Allow write (upload/delete) only if user owns the path.
      //
      // text/plain and text/markdown are accepted because the press takes .txt
      // and .md manuscripts as well as Word documents. The creator-hub sets the
      // content type explicitly on upload, since browsers report an empty type
      // for .md often enough to break the upload otherwise.
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024  // 50MB limit
        && request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain|text/markdown');
      
      // Allow delete only if user owns the file
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    /**
     * Agreements an author attaches to a rights claim.
     *
     * Keyed by the OWNER's uid rather than the book id alone, so ownership is
     * provable from the path without a Firestore read, matching the books block
     * above. `RightsGrant.evidenceRef` stores this path.
     *
     * PRIVATE to the author and to staff. A publishing contract with a third
     * party is commercially sensitive and is nobody else's business; there is
     * deliberately no published-book exception the way there is for cover art.
     *
     * Attaching a file is the author answering Wolly's question. It is not a
     * claim that anyone has read it: that is `verificationState`, which is
     * server-owned and which no author can write.
     */
    match /rights/{userId}/{bookId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Future: User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB limit
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Books pressed by @wolly/converter.
    //
    // DENIED TO EVERY CLIENT, deliberately and explicitly. These are the
    // finished EPUB and PDF, including paid books, and the only legitimate way
    // to obtain one is the `getBookDownloadUrl` function, which checks purchase
    // entitlement and rights status and then issues a 15-minute signed URL.
    // The bucket also has no public IAM binding, so the storage.googleapis.com
    // form of these paths is not readable either.
    //
    // This block grants nothing; it exists so the reason is written down at the
    // path itself, and so a later permissive wildcard has to argue with it.
    match /converted/{allPaths=**} {
      allow read, write: if false;
    }

    // Blog media (cover art and inline post images).
    //
    // Read is PUBLIC and deliberately so: these images are embedded in
    // server-rendered pages that logged-out readers and search-engine crawlers
    // fetch, and neither can authenticate. Only the owning creator can write.
    match /blog/{pubId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/publications/$(pubId)).data.ownerUserId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024  // 10MB limit
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');

      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/publications/$(pubId)).data.ownerUserId == request.auth.uid;
    }
  }
}



